# eBird API key from https://ebird.org/api/keygen
EBIRD_API_KEY=your-ebird-api-key-here

# Cache settings (optional)
CACHE_TYPE=json
CACHE_DIR=./.cache
CACHE_TTL_DAYS=30

# Grid size in km (optional, default 10)
GRID_SIZE_KM=10

# PostgreSQL (only needed if CACHE_TYPE=postgres)
# POSTGRES_URL=postgresql://user:pass@localhost:5432/dbname

# Resolution API (optional - falls back to local UUID generation)
# RESOLUTION_API_URL=https://birdlife.tech/api/v1
# RESOLUTION_API_TOKEN=your-token-here
